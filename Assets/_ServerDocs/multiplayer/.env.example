# Copier ce fichier en ".env" à côté de docker-compose.yml et remplir les valeurs.
# NE JAMAIS committer le ".env" réel dans un dépôt git.

# --- Postgres ---
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres

# --- JWT partagé entre GoTrue et PostgREST ---
# Générer avec: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret-min-32-chars

# --- GoTrue (Auth) ---
SITE_URL=https://ton-domaine.com
# En dev/test sans serveur mail configuré, autoconfirm=true évite l'étape email.
# À repasser sur false + config SMTP avant une vraie mise en prod publique.
GOTRUE_MAILER_AUTOCONFIRM=true

# --- Clés API pour PostgREST (générées via jwt.io avec JWT_SECRET, role "anon"/"service_role") ---
ANON_KEY=change-me-anon-jwt
SERVICE_ROLE_KEY=change-me-service-role-jwt

# --- Serveur de jeu Unity headless ---
GAME_SERVER_PORT=7777
# Le serveur de jeu écrit ses résultats de match via PostgREST (rôle service_role, contourne
# RLS) plutôt que via une connexion Postgres directe — voir Assets/Scripts/Server/MatchSessionManager.cs.
# REST_URL (http://rest:3000, réseau Docker interne) est fixé directement dans docker-compose.yml.
