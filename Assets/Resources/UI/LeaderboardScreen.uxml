<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(8, 10, 12, 0.9);">
        <ui:VisualElement class="panel" style="width: 80%; max-width: 640px; height: 70%;">
            <ui:Label text="🏆 CLASSEMENT" class="title" style="margin-bottom: 16px;" />
            <ui:Label name="loading-label" text="Chargement..." class="hint" />
            <ui:ScrollView name="scroll-view" style="flex-grow: 1;">
                <ui:VisualElement name="list-container" />
            </ui:ScrollView>
            <ui:Button name="close-button" text="Fermer" style="margin-top: 16px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
