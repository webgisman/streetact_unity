<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(8, 10, 12, 0.9); picking-mode: Ignore;">
        <ui:VisualElement class="panel" style="width: 80%; max-width: 640px; height: 70%;">
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 16px;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/trophy.png'); -unity-background-image-tint-color: var(--color-accent); margin-right: 12px;" />
                <ui:Label text="CLASSEMENT" class="title" style="-unity-text-align: middle-left;" />
            </ui:VisualElement>
            <ui:Label name="loading-label" text="Chargement..." class="hint" />
            <ui:ScrollView name="scroll-view" style="flex-grow: 1;">
                <ui:VisualElement name="list-container" />
            </ui:ScrollView>
            <ui:Button name="close-button" text="Fermer" class="btn-secondary" style="margin-top: 16px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
