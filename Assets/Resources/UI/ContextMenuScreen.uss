/* Tactical Centered Dialog / Context Menu Styles */
.context-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    picking-mode: Ignore;
}

.context-panel {
    background-color: rgba(14, 16, 22, 0.98);
    border-color: rgba(198, 150, 46, 0.5);
    border-width: 2px;
    border-top-width: 4px;
    border-top-color: rgb(212, 160, 23);
    border-radius: 10px;
    padding: 16px 20px;
    min-width: 320px;
    max-width: 460px;
    picking-mode: Position;
}

.context-title {
    color: rgb(255, 220, 100);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
}

.context-button {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-left-width: 4px;
    padding: 10px 14px;
    margin-bottom: 8px;
    min-height: 46px;
    color: rgb(245, 245, 245);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    transition-duration: 0.15s;
}

.context-button:hover {
    background-color: rgba(41, 128, 185, 0.35);
    border-color: rgb(52, 152, 219);
    color: white;
}

.context-button:active {
    background-color: rgba(41, 128, 185, 0.6);
    scale: 0.98;
}

.context-cancel-btn {
    height: 42px;
    background-color: rgba(231, 76, 60, 0.15);
    border-color: rgba(231, 76, 60, 0.5);
    border-width: 1px;
    border-radius: 6px;
    color: rgb(240, 130, 120);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    transition-duration: 0.15s;
    margin-top: 4px;
}

.context-cancel-btn:hover {
    background-color: rgba(231, 76, 60, 0.35);
    border-color: rgb(231, 76, 60);
    color: white;
}

.context-cancel-btn:active {
    background-color: rgba(231, 76, 60, 0.6);
    scale: 0.98;
}

