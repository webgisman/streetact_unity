<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(8, 10, 12, 0.95); picking-mode: Ignore;">
        <ui:VisualElement class="panel" style="width: 80%; max-width: 800px; height: 80%;">
            <ui:Label text="NOTIFICATIONS" class="title" style="margin-bottom: 24px;" />

            <!-- ScrollView for Notifications List -->
            <ui:ScrollView name="notifications-scroll" style="flex-grow: 1; margin-bottom: 24px; background-color: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;" />

            <ui:Button name="btn-close" class="btn-secondary" style="min-height: 72px;">
                <ui:Label text="RETOUR AU HUB" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
