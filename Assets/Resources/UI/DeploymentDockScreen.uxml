<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="DeploymentDockScreen.uss" />
    <ui:VisualElement name="root" style="flex-grow: 1; picking-mode: Ignore; flex-direction: row; justify-content: flex-start;">

        <!-- Hauteur FIXE (85%) quel que soit l'état ouvert/fermé, tab-button collé en bas : un
             conteneur qui se redimensionne à chaque ouverture décalait le bouton visible de sa vraie
             zone cliquable sur Android. -->
        <ui:VisualElement style="position: absolute; left: 4%; bottom: 3%; width: 60%; max-width: 540px; height: 85%; justify-content: flex-end; align-items: flex-start; picking-mode: Ignore;">
            <ui:VisualElement name="dock-panel" class="dock-panel slide-in" style="display: none; width: 100%; flex-grow: 1; margin-bottom: 3%;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                    <ui:Label text="VOS TROUPES" class="dock-title" />
                    <ui:Label name="effectifs-label" text="0 / 12" class="dock-effectifs" />
                </ui:VisualElement>
                <ui:Label text="Touchez une unité, puis un endroit de la carte pour la placer." class="dock-hint" />

                <ui:ScrollView name="unit-scroll" style="flex-grow: 1; min-height: 0; padding-right: 8px;">
                    <ui:Button name="btn-fantassin" class="dock-unit-btn">
                        <ui:VisualElement class="dock-unit-icon" style="background-image: url('/Assets/UI/Icons/medal.png');" />
                        <ui:VisualElement class="dock-unit-text">
                            <ui:Label text="Fantassin" class="dock-unit-name" />
                            <ui:Label text="Entre dans les immeubles et monte sur les toits." class="dock-unit-desc" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="btn-leopard" class="dock-unit-btn">
                        <ui:VisualElement class="dock-unit-icon" style="background-image: url('/Assets/UI/Icons/shield.png');" />
                        <ui:VisualElement class="dock-unit-text">
                            <ui:Label text="Char Leopard 2" class="dock-unit-name" />
                            <ui:Label text="Très résistant, tir puissant. Reste dans les rues." class="dock-unit-desc" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="btn-canon" class="dock-unit-btn">
                        <ui:VisualElement class="dock-unit-icon" style="background-image: url('/Assets/UI/Icons/explosion.png');" />
                        <ui:VisualElement class="dock-unit-text">
                            <ui:Label text="Véhicule canon" class="dock-unit-name" />
                            <ui:Label text="Tire plus vite que le char, mais moins blindé." class="dock-unit-desc" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="btn-mortier" class="dock-unit-btn">
                        <ui:VisualElement class="dock-unit-icon" style="background-image: url('/Assets/UI/Icons/crosshair.png');" />
                        <ui:VisualElement class="dock-unit-text">
                            <ui:Label text="Mortier (2 max)" class="dock-unit-name" />
                            <ui:Label text="Bombarde de très loin le point que vous touchez." class="dock-unit-desc" />
                        </ui:VisualElement>
                    </ui:Button>
                    <ui:Button name="btn-barricade" class="dock-unit-btn">
                        <ui:VisualElement class="dock-unit-icon" style="background-image: url('/Assets/UI/Icons/barrier.png');" />
                        <ui:VisualElement class="dock-unit-text">
                            <ui:Label text="Barricade" class="dock-unit-name" />
                            <ui:Label text="Bloque une rue. Touchez encore pour en aligner d'autres." class="dock-unit-desc" />
                        </ui:VisualElement>
                    </ui:Button>
                </ui:ScrollView>

                <!-- Hors de la liste déroulante : toujours visibles sans faire défiler. -->
                <ui:Button name="btn-auto-deploy" class="dock-action-btn secondary-btn btn-with-icon" style="justify-content: center; margin-top: 8px;">
                    <ui:VisualElement class="icon" style="width: 16px; height: 16px; background-image: url('/Assets/UI/Icons/lightning.png'); -unity-background-image-tint-color: var(--color-text-dim); margin-right: 6px;" />
                    <ui:Label text="PLACEMENT AUTOMATIQUE" />
                </ui:Button>
                <ui:Button name="btn-confirm-deployment" class="dock-confirm-btn">
                    <ui:Label name="confirm-deployment-label" text="COMMENCER LA BATAILLE" />
                </ui:Button>
            </ui:VisualElement>

            <ui:Button name="tab-button" class="dock-tab-button btn-with-icon" style="width: 100%; justify-content: center;">
                <ui:VisualElement class="icon icon-sm" style="background-image: url('/Assets/UI/Icons/crate.png'); -unity-background-image-tint-color: var(--color-accent-text);" />
                <ui:Label name="tab-button-label" text="VOS TROUPES" />
            </ui:Button>
        </ui:VisualElement>

        <ui:Label name="placing-banner" text="" class="dock-placing-banner" style="display: none; position: absolute; top: 10%; align-self: center; picking-mode: Ignore;" />
        <ui:Label name="status-message" text="" class="dock-status" style="display: none; position: absolute; bottom: 20%; align-self: center; picking-mode: Ignore;" />

    </ui:VisualElement>
</ui:UXML>
