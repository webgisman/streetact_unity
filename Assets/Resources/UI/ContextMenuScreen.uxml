<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="ContextMenuScreen.uss" />
    <ui:VisualElement name="root" class="context-root">
        <ui:VisualElement name="backdrop" class="context-backdrop" />
        <ui:VisualElement name="menu-panel" class="context-panel" style="width: 88%; max-width: 420px;">
            <ui:VisualElement class="context-panel__handle" />
            <ui:Label name="menu-title" text="" class="context-title" />
            <ui:VisualElement name="button-container" />
            <ui:Button name="cancel-button" text="Annuler" class="context-cancel" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
