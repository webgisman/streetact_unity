<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(8, 10, 12, 0.85); picking-mode: Ignore;">
        <ui:Button name="back-button" class="btn-secondary btn-with-icon" style="position: absolute; top: 4%; left: 4%; min-width: 160px; min-height: 56px; justify-content: center;">
            <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/chevron_left.png'); margin-right: 8px;" />
            <ui:Label text="RETOUR" />
        </ui:Button>
        <ui:VisualElement name="panel" class="panel" style="width: 70%; max-width: 620px;">
            <ui:Label name="title-label" text="CONNEXION MULTIJOUEUR" class="title" style="margin-bottom: 24px;" />

            <ui:Label text="Email :" class="hint" />
            <ui:TextField name="email-field" style="margin-bottom: 16px;" />

            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                <ui:Label text="Mot de passe (6 caractères min.) :" class="hint" />
                <ui:Toggle name="show-password-toggle" label="Afficher" />
            </ui:VisualElement>
            <ui:TextField name="password-field" password="true" style="margin-bottom: 16px;" />

            <ui:VisualElement name="username-container" style="margin-bottom: 16px;">
                <ui:Label text="Pseudo :" class="hint" />
                <ui:TextField name="username-field" />
            </ui:VisualElement>

            <ui:Button name="submit-button" text="Se connecter" class="btn-primary" style="min-height: 76px; margin-bottom: 12px;" />
            <ui:Button name="toggle-mode-button" text="Pas encore de compte ? Créer un compte" style="background-color: transparent; border-width: 0;" />

            <!-- Éditeur uniquement (voir MultiplayerMatchController.BindUI, #if UNITY_EDITOR) : connexion
                 rapide aux 2 comptes de test pour les sessions Éditeur+téléphone, caché par défaut et
                 jamais affiché sur un vrai build. -->
            <ui:VisualElement name="test-accounts-row" style="display: none; flex-direction: row; margin-top: 16px;">
                <ui:Button name="btn-test-account-1" text="🧪 Compte test 1" class="btn-secondary" style="flex-grow: 1; margin-right: 8px;" />
                <ui:Button name="btn-test-account-2" text="🧪 Compte test 2" class="btn-secondary" style="flex-grow: 1;" />
            </ui:VisualElement>

            <ui:Label name="status-label" text="" class="error-text" style="margin-top: 12px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
