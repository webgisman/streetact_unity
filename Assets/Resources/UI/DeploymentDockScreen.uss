/* Global Animations & Effects */
.slide-in {
    transition-property: right, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.dock-tab-button {
    width: 240px;
    min-height: 54px;
    padding: 8px 16px;
    background-color: rgba(20, 20, 22, 0.85);
    border-width: 1px;
    border-color: rgba(198, 150, 46, 0.8);
    border-radius: 8px;
    color: rgb(240, 240, 240);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.dock-tab-button:hover {
    background-color: rgba(198, 150, 46, 0.2);
    border-color: rgb(255, 200, 80);
    scale: 1.02;
}

.dock-tab-button:active {
    scale: 0.98;
}

.dock-panel {
    background-color: rgba(15, 15, 18, 0.95);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 20px;
    border-top-width: 4px;
    border-top-color: rgb(198, 150, 46);
}

.dock-title {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.dock-effectifs {
    color: rgb(198, 150, 46);
    font-size: 18px;
    -unity-font-style: bold;
}

.section-header {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-top: 16px;
    margin-bottom: 8px;
    margin-left: 4px;
}

.separator {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 16px;
    margin-bottom: 16px;
}

.dock-team-btn {
    min-height: 42px;
    font-size: 16px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(180, 180, 180);
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.dock-team-btn--active-p1 {
    background-color: rgba(41, 128, 185, 0.4);
    border-color: rgb(52, 152, 219);
    color: white;
}

.dock-team-btn--active-p2 {
    background-color: rgba(192, 57, 43, 0.4);
    border-color: rgb(231, 76, 60);
    color: white;
}

.dock-unit-btn {
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-radius: 6px;
    color: rgb(220, 220, 220);
    font-size: 16px;
    padding: 12px 14px;
    margin-bottom: 8px;
    -unity-text-align: middle-left;
    transition-duration: 0.2s;
}

.dock-unit-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    translate: 4px 0;
}

.dock-unit-btn:active {
    background-color: rgba(198, 150, 46, 0.3);
}

.dock-action-btn {
    border-radius: 6px;
    font-size: 14px;
    padding: 12px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    transition-duration: 0.2s;
    border-width: 1px;
}

.danger-btn {
    background-color: rgba(231, 76, 60, 0.1);
    border-color: rgba(231, 76, 60, 0.5);
    color: rgb(231, 76, 60);
}
.danger-btn:hover { background-color: rgba(231, 76, 60, 0.3); }

.warning-btn {
    background-color: rgba(241, 196, 15, 0.1);
    border-color: rgba(241, 196, 15, 0.5);
    color: rgb(241, 196, 15);
}
.warning-btn:hover { background-color: rgba(241, 196, 15, 0.3); }

.secondary-btn {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: rgb(180, 180, 180);
}
.secondary-btn:hover { background-color: rgba(255, 255, 255, 0.15); }

.dock-placing-banner {
    background-color: rgba(198, 150, 46, 0.95);
    border-radius: 8px;
    color: rgb(20, 20, 20);
    padding: 12px 24px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dock-status {
    background-color: rgba(20, 20, 22, 0.9);
    border-radius: 8px;
    padding: 12px 20px;
    color: rgb(255, 200, 80);
    font-size: 18px;
    -unity-font-style: bold;
}
