.dock-tab-button {
    width: 210px;
    height: 46px;
    background-color: rgba(17, 21, 28, 0.92);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    color: rgb(240, 241, 245);
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}

.dock-tab-button:active {
    background-color: rgba(255, 255, 255, 0.10);
}

.dock-panel {
    background-color: rgba(17, 21, 28, 0.96);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 14px;
}

.dock-title {
    color: rgb(120, 210, 255);
    letter-spacing: 1px;
}

.dock-effectifs {
    color: rgb(200, 205, 215);
}

.dock-team-btn {
    height: 42px;
    border-radius: 10px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(210, 213, 220);
    -unity-font-style: bold;
}

.dock-team-btn--active-p1 {
    background-color: rgba(0, 160, 255, 0.28);
    border-color: rgb(0, 190, 255);
    color: rgb(255, 255, 255);
}

.dock-team-btn--active-p2 {
    background-color: rgba(255, 60, 60, 0.28);
    border-color: rgb(255, 90, 90);
    color: rgb(255, 255, 255);
}

.dock-unit-btn {
    background-color: rgba(255, 255, 255, 0.05);
    border-left-width: 4px;
    border-left-color: rgb(0, 190, 255);
    border-radius: 10px;
    color: rgb(230, 232, 238);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 12px;
}

.dock-unit-btn:active {
    background-color: rgba(255, 255, 255, 0.14);
}

.dock-action-btn {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    -unity-font-style: bold;
}

.dock-action-btn:active {
    background-color: rgba(255, 255, 255, 0.12);
}

.dock-placing-banner {
    background-color: rgba(255, 170, 0, 0.95);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 14px;
    color: rgb(20, 15, 0);
    padding: 10px 18px;
}

.dock-status {
    background-color: rgba(17, 21, 28, 0.95);
    border-width: 1px;
    border-color: rgba(255, 220, 60, 0.4);
    border-radius: 12px;
    padding: 10px 16px;
}
