/* Dock de déploiement — variante "glass" du thème commando (panneau flottant sur la scène 3D),
   entièrement pilotée par les tokens de Theme.tss : plus de palette bleue/rouge "flat UI"
   indépendante, plus de coins très arrondis façon app moderne — juste le glass + laiton déjà
   prévus pour ce cas d'usage dans Theme.tss (.btn-glass, --color-glass-*). */

.slide-in {
    transition-property: right, opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* Même traitement que Button.btn-primary (Theme.tss) — remplissage plein en accent, pas la
   variante "glass" translucide utilisée par le reste de ce dock : un fond partiellement
   transparent ne lisait toujours pas comme "identique à FIN DE TOUR" (lui en remplissage plein). */
.dock-tab-button {
    min-height: 52px;
    padding: 6px 12px;
    background-color: var(--color-accent);
    border-top-color: var(--bevel-light);
    border-left-color: var(--bevel-light);
    border-right-color: var(--bevel-dark);
    border-bottom-color: var(--bevel-dark);
    border-width: 2px;
    border-radius: 2px;
    color: var(--color-accent-text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-align: middle-center;
    transition-duration: 0.2s;
}

.dock-tab-button:hover {
    background-color: var(--color-accent-hover);
    scale: 1.02;
}

.dock-tab-button:active {
    background-color: rgb(120, 30, 24);
    scale: 0.98;
}

.dock-panel {
    background-color: rgba(20, 18, 12, 0.95);
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    border-radius: 2px;
    padding: 14px;
    border-top-width: 3px;
    border-top-color: var(--color-accent);
    /* UI Toolkit ne réduit jamais un élément sous sa taille de contenu par défaut (flex-shrink
       vaut 0, contrairement au CSS web) : sans ce overflow:hidden, une liste plus longue que
       max-height déborde visuellement en dehors du panneau au lieu d'être contenue par le
       ScrollView interne — c'est ce qui écrasait le bouton "Déploiement" en dessous. */
    overflow: hidden;
}

.dock-title {
    color: var(--color-text);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.dock-effectifs {
    color: var(--color-accent);
    font-size: 16px;
    -unity-font-style: bold;
}

.section-header {
    color: var(--color-text-dim);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    margin-top: 16px;
    margin-bottom: 8px;
    margin-left: 4px;
}

.separator {
    height: 1px;
    background-color: var(--color-panel-border-dim);
    margin-top: 10px;
    margin-bottom: 10px;
}

.dock-team-btn {
    min-height: 42px;
    font-size: 16px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    background-color: var(--color-glass-fill);
    color: var(--color-text-dim);
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.dock-team-btn--active-p1 {
    background-color: rgba(72, 128, 168, 0.4);
    border-color: var(--color-team1);
    color: var(--color-text);
}

.dock-team-btn--active-p2 {
    background-color: rgba(188, 62, 48, 0.4);
    border-color: var(--color-team2);
    color: var(--color-text);
}

.dock-unit-btn {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-glass-fill);
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    border-radius: 2px;
    color: var(--color-text);
    font-size: 16px;
    padding: 10px 11px;
    margin-bottom: 6px;
    -unity-text-align: middle-left;
    transition-duration: 0.2s;
}

.dock-unit-btn:hover {
    background-color: var(--color-glass-fill-hover);
    border-color: var(--color-accent);
    translate: 4px 0;
}

.dock-unit-btn:active {
    background-color: var(--color-glass-fill-active);
}

.dock-action-btn {
    border-radius: 2px;
    font-size: 15px;
    padding: 10px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    transition-duration: 0.2s;
    border-width: 1px;
}

.danger-btn {
    background-color: rgba(150, 42, 32, 0.15);
    border-color: var(--color-danger);
    color: rgb(224, 110, 96);
}
.danger-btn:hover { background-color: rgba(150, 42, 32, 0.35); }

.warning-btn {
    background-color: rgba(176, 48, 40, 0.12);
    border-color: var(--color-accent);
    color: var(--color-accent);
}
.warning-btn:hover { background-color: rgba(176, 48, 40, 0.3); }

.secondary-btn {
    background-color: var(--color-glass-fill);
    border-color: var(--color-panel-border-dim);
    color: var(--color-text-dim);
}
.secondary-btn:hover { background-color: var(--color-glass-fill-hover); }

.dock-placing-banner {
    background-color: var(--color-accent);
    border-radius: 2px;
    color: var(--color-accent-text);
    padding: 12px 24px;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.dock-status {
    background-color: rgba(20, 18, 12, 0.92);
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    border-radius: 2px;
    padding: 12px 20px;
    color: var(--color-accent);
    font-size: 18px;
    -unity-font-style: bold;
}

.dock-unit-icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-text);
}
