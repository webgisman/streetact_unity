<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; background-color: rgba(8, 10, 12, 0.85); picking-mode: Ignore;">
        
        <!-- PROFIL (Haut Gauche) -->
        <ui:VisualElement class="hub-chip" style="position: absolute; left: 20px; top: 20px;">
            <ui:Label name="lbl-username" text="Commandant..." style="font-size: 24px; -unity-font-style: bold; margin-bottom: 4px;" />
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement class="icon icon-sm" style="background-image: url('/Assets/UI/Icons/lightning.png'); -unity-background-image-tint-color: var(--color-resource); margin-right: 8px;" />
                <ui:Label name="lbl-action-points" text="Points d'Action : 0" class="resource-value" style="font-size: 20px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- NOTIFICATIONS (Haut Droite) — même pastille ".notif-badge" que la cloche du HUD tactique
             (TacticalBottomBarScreen), pour que l'affordance "il y a du nouveau" se lise pareil
             partout dans le jeu plutôt que via un texte "(N)" ad hoc. -->
        <ui:VisualElement style="position: absolute; right: 20px; top: 20px; align-items: center;">
            <ui:Button name="btn-notifications" class="btn-secondary btn-with-icon" style="padding: 10px 14px; min-height: 0;">
                <ui:VisualElement class="icon icon-sm" style="background-image: url('/Assets/UI/Icons/bell.png'); margin-right: 8px;" />
                <ui:Label text="Notifications" />
            </ui:Button>
            <ui:Label name="lbl-notifications-badge" text="" class="notif-badge" style="display: none;" />
        </ui:VisualElement>

        <!-- MENU CENTRAL — hauteur bornée (pas juste "auto") + ScrollView interne : la liste
             d'actions groupées par section (ajoutée ici, plus haute que les 8 boutons à plat
             d'avant) pourrait dépasser le bas de l'écran sur un téléphone bas/en paysage ; sans
             scroll, UI Toolkit ne réduit jamais un panneau sous sa taille de contenu (comme le
             dock de déploiement, voir DeploymentDockScreen.uss ".dock-panel"), ce qui couperait
             silencieusement "DÉCONNEXION" et les derniers boutons hors-champ. -->
        <ui:VisualElement name="panel" class="panel" style="width: 65%; max-width: 640px; max-height: 80%; align-self: center; margin-top: 100px;">
            <ui:Label text="HUB COMMANDEMENT" class="title" style="margin-bottom: 12px;" />

            <ui:ScrollView name="hub-actions-scroll" style="flex-grow: 1;">

            <ui:Label text="OPÉRATIONS DE COMBAT" class="hub-section-header" style="margin-top: 0;" />

            <ui:Button name="btn-conquest" class="btn-primary btn-with-icon" style="margin-bottom: 10px; min-height: 96px;">
                <ui:VisualElement class="icon icon-lg" style="background-image: url('/Assets/UI/Icons/crosshair.png');" />
                <ui:VisualElement class="btn-text-col">
                    <ui:Label text="ATTAQUER (CONQUÊTE)" />
                    <ui:Label text="Lancer une attaque sur une zone contestée" class="btn-subtitle" />
                </ui:VisualElement>
            </ui:Button>

            <!-- 2026-09-06 : seuls modes où deux joueurs vivants s'affrontent en direct (voir
                 MultiplayerMatchController.StartDeathmatch/StartZoneControl) — ATTAQUER (CONQUÊTE)
                 ci-dessus est toujours un joueur seul contre une garnison IA, jamais un adversaire
                 vivant, quelle que soit la Zone visée. -->
            <ui:Button name="btn-deathmatch" class="btn-primary btn-with-icon" style="margin-bottom: 10px; min-height: 80px;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/crossed_swords.png');" />
                <ui:VisualElement class="btn-text-col">
                    <ui:Label text="MATCH À MORT" />
                    <ui:Label text="Affrontement direct contre un vrai joueur" class="btn-subtitle" />
                </ui:VisualElement>
            </ui:Button>

            <ui:Button name="btn-zone-control" class="btn-primary btn-with-icon" style="margin-bottom: 8px; min-height: 80px;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/shield.png');" />
                <ui:VisualElement class="btn-text-col">
                    <ui:Label text="ZONE DE CONTRÔLE" />
                    <ui:Label text="Combat en direct pour tenir le terrain" class="btn-subtitle" />
                </ui:VisualElement>
            </ui:Button>

            <ui:VisualElement class="hub-separator" />
            <ui:Label text="STRATÉGIE &amp; SIÈGES" class="hub-section-header" />

            <ui:Button name="btn-zone-map" class="btn-secondary btn-with-icon" style="margin-bottom: 8px; min-height: 80px;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/flag.png');" />
                <ui:VisualElement class="btn-text-col">
                    <ui:Label text="CARTE DU MONDE" />
                    <ui:Label text="Stratégie et choix des cibles" class="btn-subtitle" />
                </ui:VisualElement>
            </ui:Button>

            <!-- Icône distincte de "ZONE DE CONTRÔLE" ci-dessus (les deux partageaient shield.png,
                 ambigu au premier coup d'oeil dans la liste) — barrier.png rappelle la défense/le
                 siège d'une position plutôt que le combat direct. -->
            <ui:Button name="btn-sieges" class="btn-secondary btn-with-icon" style="margin-bottom: 8px; min-height: 80px;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/barrier.png');" />
                <ui:VisualElement class="btn-text-col">
                    <ui:Label text="SIÈGES EN COURS" />
                    <ui:Label text="Défendre vos Zones attaquées, suivre vos attaques" class="btn-subtitle" />
                </ui:VisualElement>
            </ui:Button>

            <ui:VisualElement class="hub-separator" />
            <ui:Label text="LOGISTIQUE" class="hub-section-header" />

            <ui:Button name="btn-roster" class="btn-secondary btn-with-icon" style="margin-bottom: 8px; min-height: 80px;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/crate.png');" />
                <ui:VisualElement class="btn-text-col">
                    <ui:Label text="CASERNE (UNITÉS)" />
                    <ui:Label text="Recruter et gérer votre armée" class="btn-subtitle" />
                </ui:VisualElement>
            </ui:Button>

            <ui:Button name="btn-buildings" class="btn-secondary btn-with-icon" style="margin-bottom: 20px; min-height: 80px;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/city.png');" />
                <ui:VisualElement class="btn-text-col">
                    <ui:Label text="BÂTIMENTS &amp; RESSOURCES" />
                    <ui:Label text="Collecter les Points d'Action générés" class="btn-subtitle" />
                </ui:VisualElement>
            </ui:Button>

            <!-- Action rare/destructrice, volontairement en retrait (btn-ghost) pour ne plus
                 rivaliser visuellement avec les actions de navigation ci-dessus (retour direct sur
                 capture d'écran : la liste de 8 boutons identiques était jugée peu lisible). -->
            <ui:Button name="btn-back-startup" class="btn-ghost" style="align-self: center;">
                <ui:Label text="DÉCONNEXION" />
            </ui:Button>

            </ui:ScrollView>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
