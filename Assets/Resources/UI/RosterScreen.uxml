<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(8, 10, 12, 0.95); picking-mode: Ignore;">
        <ui:VisualElement class="panel" style="width: 80%; max-width: 800px; height: 80%;">
            <ui:Label text="CASERNE - PRÉPARATION DES UNITÉS" class="title" style="margin-bottom: 24px;" />
            
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; margin-bottom: 24px; padding: 12px; background-color: rgba(20,25,30,0.9); border-radius: 8px;">
                <ui:Label text="Recrutez des unités avec vos Points d'Action. Elles seront ajoutées à votre inventaire pour le déploiement." style="color: white; font-size: 16px; white-space: normal; flex-shrink: 1;" />
                <ui:Label name="lbl-action-points" text="Solde : ..." style="color: gold; font-size: 20px; -unity-font-style: bold; min-width: 150px; -unity-text-align: middle-right;" />
            </ui:VisualElement>

            <!-- ScrollView for Roster Items -->
            <ui:ScrollView name="roster-scroll" style="flex-grow: 1; margin-bottom: 24px; background-color: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;" />

            <ui:Button name="btn-close" class="btn-secondary" style="min-height: 72px;">
                <ui:Label text="RETOUR AU HUB" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
