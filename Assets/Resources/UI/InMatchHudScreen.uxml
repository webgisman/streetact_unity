<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <!-- padding-top dégage la bande réservée par TacticalBottomBarScreen.uxml en haut d'écran
         (portraits d'escouade + cloche + FIN DE TOUR + colonne radar) — les deux écrans sont
         superposés en permanence pendant un match PvP (voir UIScreenManager.Show("InMatchHud") +
         SetVisible("TacticalBottomBar", true) simultanés), et la bannière équipe/timer/phase
         ci-dessous se dessinait PAR-DESSUS ce dashboard sans ce dégagement — chevauchement direct,
         jamais visible en solo puisque InMatchHud n'y est jamais affiché (voir rapport
         utilisateur : "chevauchement... dans le mode multijoueur"). La valeur ci-dessous (180px)
         n'est qu'un REPLI affiché une fraction de frame au tout premier affichage : dès la
         première frame en UiState.InMatch, MultiplayerMatchController.RefreshHudDynamicFields()
         l'écrase avec la vraie hauteur du radar (TacticalRadarUI.BottomEdgeVirtualY, dynamique
         depuis son agrandissement le 2026-09-02) — ne PAS ajuster cette valeur statique pour
         "corriger" un chevauchement, corriger plutôt le calcul dynamique côté C#. -->
    <ui:VisualElement name="root" style="flex-grow: 1; padding-top: 180px; picking-mode: Ignore;">

        <ui:VisualElement name="top-bar" style="flex-direction: row; justify-content: space-between; align-items: flex-start; padding: 12px 24px; picking-mode: Ignore;">
            <ui:Label name="team-banner" text="ÉQUIPE BLEUE" class="team1-badge" style="font-size: 30px; picking-mode: Ignore;" />
            <ui:Label name="timer-label" text="" class="panel" style="font-size: 32px; -unity-font-style: bold; padding: 8px 20px; picking-mode: Ignore;" />
        </ui:VisualElement>

        <ui:Label name="phase-label" text="PLANIFICATION" class="panel" style="align-self: center; margin-top: 8px; font-size: 28px; -unity-font-style: bold; padding: 6px 24px; picking-mode: Ignore;" />

        <ui:VisualElement name="zone-bar-container" style="display: none; align-self: center; width: 60%; margin-top: 16px; picking-mode: Ignore;">
            <ui:Label text="ZONE DE CONTRÔLE" class="hint" style="align-self: center; margin-bottom: 4px; picking-mode: Ignore;" />
            <ui:VisualElement style="flex-direction: row; height: 24px; picking-mode: Ignore;">
                <ui:VisualElement name="zone-fill-team1" class="progress-bar-fill-team1" style="width: 0%; picking-mode: Ignore;" />
                <ui:VisualElement name="zone-fill-team2" class="progress-bar-fill-team2" style="width: 0%; picking-mode: Ignore;" />
                <ui:VisualElement name="zone-fill-empty" style="flex-grow: 1; background-color: rgb(12, 15, 18); picking-mode: Ignore;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="ghost-banner" text="" class="panel" style="display: none; align-self: center; margin-top: 16px; color: var(--color-danger); font-size: 26px; -unity-font-style: bold; picking-mode: Ignore;" />

    </ui:VisualElement>
</ui:UXML>
