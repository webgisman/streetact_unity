<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(8, 10, 12, 0.95); picking-mode: Ignore;">
        <ui:VisualElement class="panel" style="width: 80%; max-width: 800px; height: 80%;">
            <ui:Label text="SIÈGES EN COURS" class="title" style="margin-bottom: 24px;" />

            <ui:VisualElement class="hub-info-banner" style="margin-bottom: 16px; font-size: 20px;">
                <ui:Label text="Un siège se joue au tour par tour dès que l'attaquant et le défenseur sont en ligne en même temps (DÉFENDRE / REJOINDRE). Sinon, à la fin du compte à rebours, la bataille se joue automatiquement avec les troupes des casernes." />
            </ui:VisualElement>

            <ui:ScrollView name="sieges-scroll" style="flex-grow: 1; margin-bottom: 24px; background-color: rgba(0,0,0,0.2); padding: 8px; border-radius: 4px;" />

            <ui:Button name="btn-close" class="btn-secondary btn-with-icon" style="min-height: 72px; justify-content: center;">
                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/chevron_left.png'); margin-right: 8px;" />
                <ui:Label text="RETOUR" />
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
