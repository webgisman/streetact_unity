<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; picking-mode: Ignore; width: 100%; height: 100%;">

        <!-- Tableau de bord tactique — chaque bouton flotte directement sur la scène 3D avec son
             propre fond "glass"/plein (même langage que ContextMenuScreen/DeploymentDockScreen,
             voir Theme.tss), plus de bandeau opaque derrière : ça rendait ce coin de l'écran
             illisible/moche et masquait la carte en dessous sans raison, l'espace vide entre les
             boutons ne devant de toute façon jamais bloquer la vue. picking-mode: Ignore laisse les
             taps traverser cet espace vide vers la scène 3D — chaque Button gère son propre picking. -->
        <ui:VisualElement name="top-dashboard" style="position: absolute; top: 0; left: 0; right: 0; height: 16%; min-height: 120px; max-height: 175px; picking-mode: Ignore; flex-direction: row; justify-content: space-between; padding: 8px 14px;">

            <!-- Left/Center Main Column -->
            <ui:VisualElement style="flex-grow: 1; flex-direction: column; justify-content: space-between; picking-mode: Ignore; margin-right: 15px;">

                <!-- Row 1: Squad Group Portraits (Left) + Notification Bell + End Turn (Right) -->
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; min-height: 56px; picking-mode: Ignore;">

                    <!-- Squad Portraits -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; picking-mode: Ignore;">
                        <ui:VisualElement name="squad-bar" style="flex-direction: row; align-items: center; picking-mode: Ignore;" />
                    </ui:VisualElement>

                    <!-- Top-Right Actions: Bell + End Turn -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; picking-mode: Ignore;">

                        <ui:VisualElement name="planification-group" style="picking-mode: Ignore; margin-right: 12px;">
                            <ui:VisualElement name="notif-bell-wrap" style="align-items: center;">
                                <ui:Button name="notif-bell-button" class="btn-glass btn-icon-only" style="width: 44px; height: 44px; border-radius: 22px;">
                                    <ui:VisualElement class="icon icon-sm" style="background-image: url('/Assets/UI/Icons/bell.png');" />
                                </ui:Button>
                                <ui:Label name="notif-bell-badge" text="" class="notif-badge" style="display: none;" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement name="top-actions-row" style="flex-direction: row; align-items: center; picking-mode: Ignore;">
                            <!-- Bascule caméra 2D/3D : réglage de vue, pas un ordre tactique, donc
                                 séparée du flux de sélection/déplacement (voir ContextMenuScreen).
                                 btn-glass (comme la cloche juste à côté) plutôt que btn-secondary :
                                 son fond plein sombre se fondait dans une carte sombre une fois le
                                 bandeau noir retiré derrière lui, le rendant quasi invisible. -->
                            <ui:Button name="view3d-button" class="btn-glass btn-icon-only" style="display: none; height: 48px; width: 48px; margin-right: 10px;">
                                <ui:VisualElement class="icon" style="background-image: url('/Assets/UI/Icons/magnifier.png');" />
                            </ui:Button>
                            <ui:Button name="end-turn-button" class="btn-primary btn-with-icon" style="height: 52px; min-width: 168px; padding: 0 18px; justify-content: center;">
                                <ui:VisualElement class="icon icon-sm" style="background-image: url('/Assets/UI/Icons/play.png'); -unity-background-image-tint-color: var(--color-accent-text); margin-right: 8px;" />
                                <ui:Label text="FIN DE TOUR" style="font-size: 20px;" />
                            </ui:Button>
                        </ui:VisualElement>

                        <!-- Execution Group -->
                        <ui:VisualElement name="execution-group" style="display: none; flex-direction: row; align-items: center; picking-mode: Position;">
                            <ui:Label name="execution-label" text="ACTION EN COURS..." class="panel" style="color: var(--color-accent); font-size: 18px; -unity-font-style: bold; padding: 8px 14px; margin-right: 8px;" />
                            <ui:Button name="skip-button" text="Passer" class="btn-secondary" style="height: 48px; padding: 0 14px; font-size: 17px;" />
                        </ui:VisualElement>

                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Dedicated Right Column for Radar -->
            <ui:VisualElement style="width: 16%; min-width: 120px; max-width: 175px; height: 100%; picking-mode: Ignore;" />

        </ui:VisualElement>

        <!-- Toast temporaire : tap sur un endroit non atteignable pour l'unité sélectionnée
             (voir ShowInvalidTapFeedback dans TacticalPathManager.cs). Indépendant de l'écran
             ContextMenu pour rester visible même quand aucun sous-menu d'ordre n'est ouvert. -->
        <ui:Label name="invalid-tap-toast" text="IMPOSSIBLE D'ALLER ICI" style="display: none; position: absolute; top: 42%; left: 8%; right: 8%; background-color: rgba(150, 42, 32, 0.94); color: rgb(248, 224, 216); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; padding: 16px 20px; border-radius: 2px; border-width: 1px; border-color: var(--color-danger-hover); picking-mode: Ignore;" />

    </ui:VisualElement>
</ui:UXML>
