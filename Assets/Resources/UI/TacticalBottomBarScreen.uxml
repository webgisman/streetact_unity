<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; picking-mode: Ignore; width: 100%; height: 100%;">

        <!-- Barre de commandes de la bataille : chaque bouton flotte sur la carte avec son propre fond
             (Theme.tss) ; l'espace vide entre eux laisse passer les taps vers la carte. -->
        <ui:VisualElement name="top-dashboard" style="position: absolute; top: 0; left: 0; right: 0; height: 16%; min-height: 120px; max-height: 175px; picking-mode: Ignore; flex-direction: row; justify-content: space-between; padding: 8px 14px;">

            <ui:VisualElement style="flex-grow: 1; flex-direction: column; justify-content: space-between; picking-mode: Ignore; margin-right: 15px;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; min-height: 56px; picking-mode: Ignore;">

                    <!-- Portraits par type d'unité (toucher = sélectionner la suivante de ce type). -->
                    <ui:VisualElement style="flex-direction: row; align-items: center; picking-mode: Ignore;">
                        <ui:VisualElement name="squad-bar" style="flex-direction: row; align-items: center; picking-mode: Ignore;" />
                    </ui:VisualElement>

                    <!-- Toutes les actions du tour dans un seul bandeau (.hud-action-cluster). Des mots
                         plutôt que des icônes seules : une cloche, un viseur ou une flèche « ↶ » (absente
                         de la police) ne disaient pas ce que faisait le bouton. -->
                    <ui:VisualElement name="top-actions-row" class="hud-action-cluster" style="picking-mode: Position;">
                        <ui:Button name="hud-menu-button" text="MENU" class="btn-glass hud-text-btn" />

                        <ui:VisualElement name="planification-group" style="flex-direction: row; align-items: center; picking-mode: Ignore;">
                            <!-- Sélectionne tour à tour vos unités blessées ; affiché seulement s'il y en a. -->
                            <ui:Button name="wounded-button" text="BLESSÉS" class="btn-glass hud-text-btn" style="display: none;" />
                            <ui:Button name="view3d-button" text="VUE 3D" class="btn-glass hud-text-btn" style="display: none;" />
                            <ui:Button name="undo-node-button" text="RETIRER LE POINT" class="btn-glass hud-text-btn" style="display: none;" />
                        </ui:VisualElement>

                        <ui:Button name="end-turn-button" class="btn-primary btn-with-icon" style="height: 52px; min-width: 168px; padding: 0 18px; justify-content: center;">
                            <ui:VisualElement class="icon icon-sm" style="background-image: url('/Assets/UI/Icons/play.png'); -unity-background-image-tint-color: var(--color-accent-text); margin-right: 8px;" />
                            <ui:Label text="FIN DE TOUR" style="font-size: 20px;" />
                        </ui:Button>

                        <ui:VisualElement name="execution-group" style="display: none; flex-direction: row; align-items: center; picking-mode: Position;">
                            <ui:Label name="execution-label" text="ACTION EN COURS..." class="panel" style="color: var(--color-accent); font-size: 18px; -unity-font-style: bold; padding: 8px 14px; margin-right: 8px;" />
                            <!-- Solo uniquement : accélère le tour en cours (en ligne, le rythme du rejeu
                                 est celui du serveur). -->
                            <ui:Button name="skip-button" text="ACCÉLÉRER" class="btn-secondary hud-text-btn" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Colonne réservée au radar (TacticalRadarUI.OnGUI : 26% de la plus petite dimension
                 d'écran, borné [140,230] px) : la barre ne passe jamais dessous. -->
            <ui:VisualElement style="width: 26%; min-width: 140px; max-width: 230px; height: 100%; picking-mode: Ignore;" />

        </ui:VisualElement>

        <!-- Ce qu'il faut faire maintenant (TacticalPathManager.RefreshTurnHint). -->
        <ui:Label name="turn-hint" text="" class="turn-hint" style="display: none; position: absolute; bottom: 3%; left: 30%; right: 18%; picking-mode: Ignore;" />

        <!-- Toast : tap sur un endroit non atteignable, ou avertissement avant FIN DE TOUR. -->
        <ui:Label name="invalid-tap-toast" text="IMPOSSIBLE D'ALLER ICI" style="display: none; position: absolute; top: 42%; left: 8%; right: 8%; background-color: rgba(150, 42, 32, 0.94); color: rgb(248, 224, 216); font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; padding: 16px 20px; border-radius: 2px; border-width: 1px; border-color: var(--color-danger-hover); picking-mode: Ignore;" />

    </ui:VisualElement>
</ui:UXML>
