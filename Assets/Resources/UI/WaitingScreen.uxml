<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="root" style="flex-grow: 1; align-items: center; justify-content: center; background-color: rgba(8, 10, 12, 0.85); picking-mode: Ignore;">
        <ui:VisualElement class="panel" style="width: 70%; max-width: 500px; align-items: center;">
            <ui:Label name="status-label" text="Connexion..." class="subtitle" style="font-size: 28px; color: rgb(232, 222, 196);" />
            <ui:VisualElement name="ai-hint-row" style="display: none; align-items: center; margin-top: 28px;">
                <ui:Label text="Aucun adversaire pour l'instant ?" class="btn-subtitle" style="text-align: center; margin-bottom: 12px;" />
                <ui:Button name="btn-play-vs-ai" text="🤖 JOUER CONTRE L'IA EN ATTENDANT" class="btn-team2" style="display: none; min-height: 64px; min-width: 320px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
