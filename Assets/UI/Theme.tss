/*
 * Thème visuel global "commando WWII" — inspiré de Commandos: Behind Enemy Lines
 * (plaques métal/laiton, panneaux khaki rectangulaires, typographie tampon militaire).
 * Chaque écran importe ce thème (héritage automatique via PanelSettings.themeStyleSheet) et
 * n'a besoin que de ses propres règles de mise en page par-dessus.
 *
 * Le relief "plaque métallique" est simulé avec un biseau de bordure (clair en haut/gauche,
 * sombre en bas/droite) plutôt que des coins arrondis modernes — UI Toolkit ne supporte ni
 * box-shadow portable, ni clip-path, donc c'est la technique la plus robuste disponible.
 */

:root {
    --color-bg-dark: rgb(20, 18, 12);
    --color-panel: rgb(46, 42, 30);
    --color-panel-2: rgb(58, 52, 36);
    --color-panel-border: rgb(150, 128, 74);
    --color-panel-border-dim: rgb(94, 82, 54);
    --color-text: rgb(232, 222, 196);
    --color-text-dim: rgb(176, 162, 126);

    /* Couleurs d'équipe — conservées proches du bleu/rouge d'origine : elles encodent
       l'identité joueur/ennemi ailleurs dans le code (marqueurs radar, badges réseau)
       et changer la teinte casserait cette lecture immédiate en jeu. */
    --color-team1: rgb(72, 128, 168);
    --color-team2: rgb(188, 62, 48);

    /* CTA unique de toute l'UI — rouge signal, jamais réutilisé ailleurs. Plus saturé/vif que
       --color-danger (rouge sourd déjà utilisé pour l'annulation/erreur) pour rester distinguable :
       celui-ci est "action principale", l'autre "attention/danger". --color-accent-text est CLAIR
       (pas sombre comme avant le passage du laiton au rouge) pour rester lisible sur ce fond. */
    --color-accent: rgb(176, 48, 40);
    --color-accent-hover: rgb(204, 74, 62);
    --color-accent-text: rgb(246, 228, 220);

    --color-danger: rgb(150, 42, 32);
    --color-danger-hover: rgb(180, 60, 46);
    --color-success: rgb(96, 132, 64);

    /* Couleur unique pour toute valeur de ressource (Points d'Action) — remplace le "gold" CSS
       nommé utilisé au coup par coup (ModeSelect/RosterScreen, avant ce passage) : ce jaune web pur
       tranchait avec la palette khaki/laiton sourde du reste du thème. Un seul token ici garantit
       que l'AP se lit avec exactement la même teinte partout où elle apparaît. */
    --color-resource: rgb(196, 164, 64);

    /* Boutons "glass" (menus flottants sur la scène 3D) : le fond doit rester lisible
       même sans hover, donc pas d'alpha proche de 0 — voir Button.btn-glass ci-dessous. */
    --color-glass-fill: rgba(232, 222, 196, 0.14);
    --color-glass-fill-hover: rgba(232, 222, 196, 0.22);
    --color-glass-fill-active: rgba(232, 222, 196, 0.30);
    --color-glass-border: rgba(176, 48, 40, 0.55);

    --bevel-light: rgba(255, 246, 220, 0.4);
    --bevel-light-soft: rgba(255, 246, 220, 0.22);
    --bevel-dark: rgba(0, 0, 0, 0.4);
    --bevel-dark-soft: rgba(0, 0, 0, 0.28);

    /* Couleur d'accompagnement pour les actions "info / observation" (guetter, surveiller...)
       dans le menu contextuel tactique — remplace le cyan néon utilisé auparavant au coup par
       coup dans TacticalPathManager, pour rester dans la même famille sourde que le reste du thème. */
    --color-info: rgb(90, 130, 152);
    --color-info-hover: rgb(112, 156, 180);

    --font-head: url("/Assets/Fonts/BlackOpsOne-Regular.ttf");
    /* CORRECTIF (2026-09-13, trouvé lors du premier vrai test à 2 clients Play Mode) : le fichier
       "Oswald-Variable.ttf" est une police VARIABLE (une seule police OpenType encodant plusieurs
       graisses via des axes, d'où son nom) — UI Toolkit ne sait PAS instancier de police variable
       pour son rendu de texte dynamique à l'exécution (moteur FreeType interne). Résultat en jeu
       (jamais visible dans le Game View de l'Éditeur avant ce test, seulement dans un vrai build
       Player) : "Unable to generate text. Failed to load font 'Oswald' ... The font face could not
       be initialized." en boucle — TOUT texte utilisant --font-body (donc la quasi-totalité des
       Label/Button du jeu, --font-head/BlackOpsOne n'étant lui PAS variable et donc épargné) ne
       s'affichait tout simplement pas. Repli sur LiberationSans (police STATIQUE déjà présente,
       fournie par le package TextMesh Pro Essentials, donc garantie de fonctionner) : moins fidèle
       à l'identité visuelle "commando" voulue que l'Oswald condensé, mais du texte qui s'affiche
       vraiment vaut mieux qu'une police plus jolie mais invisible. Pour restaurer l'Oswald condensé,
       il faudra une vraie police STATIQUE (ex. "Oswald-Regular.ttf", une graisse fixe extraite de la
       famille variable — disponible séparément sur Google Fonts), pas ce fichier "-Variable". */
    --font-body: url("/Assets/TextMesh Pro/Fonts/LiberationSans.ttf");
}

/* Transition d'apparition des écrans plein-cadre (2026-09-13, demande explicite : "il faut que
   tout soit intuitif et gamefiable") — UIScreenManager applique cette classe UNE FOIS à chaque
   écran instancié (voir Awake()) et pilote opacity/scale depuis Show()/SetVisible() : display
   (none<->flex) n'est PAS transformable par UI Toolkit, donc c'est le VRAI mécanisme (contrairement
   à .slide-in ci-dessous sur DeploymentDockScreen, jamais réellement déclenché par du code — right/
   opacity n'y sont modifiés nulle part, transition purement déclarative sans effet visible). Centralisé
   ICI (thème global, hérité par tout écran sans le moindre import) plutôt que dupliqué par écran :
   un seul endroit à ajuster si la sensation doit changer un jour. */
.screen-fade {
    transition-property: opacity, scale;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

/* "Cartes" de liste réutilisables (Caserne/Bâtiments/Sièges, 2026-09-13, demande explicite
   "intuitif et gamefiable") — remplace les lignes texte brut sans relief d'avant (juste un
   séparateur horizontal) par un vrai panneau avec profondeur/survol, dans le même langage visuel
   que .panel/Button plutôt qu'une palette indépendante. Construites dynamiquement en C#
   (MultiplayerMatchController.Refresh*Screen) — pas de PNG chargée à l'exécution ici
   (Resources.Load ne verrait pas Assets/UI/Icons/*, hors d'un dossier Resources) : la richesse
   visuelle vient de la couleur/mise en page, pas d'icônes par ligne. */
.hub-card {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: var(--color-panel-2);
    border-width: 1px;
    border-top-color: var(--bevel-light-soft);
    border-left-color: var(--bevel-light-soft);
    border-right-color: var(--bevel-dark-soft);
    border-bottom-color: var(--bevel-dark-soft);
    border-radius: 2px;
    padding: 12px 14px;
    margin-bottom: 8px;
    transition-property: background-color, translate;
    transition-duration: 0.12s;
}
.hub-card:hover {
    background-color: var(--color-glass-fill-hover);
    translate: 3px 0;
}

.hub-card-title {
    color: var(--color-text);
    font-size: 18px;
    -unity-font-style: bold;
    white-space: normal;
}

.hub-card-subtitle {
    color: var(--color-text-dim);
    font-size: 14px;
    white-space: normal;
    margin-top: 2px;
}

/* Pastille numérique (quantité possédée, ex: Caserne) — même traitement que .notif-badge, jamais
   du texte nu sans fond (illisible selon ce qu'il y a derrière, déjà corrigé ailleurs pour
   .squad-count-badge). */
.hub-count-badge {
    background-color: var(--color-glass-fill);
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    border-radius: 10px;
    padding: 2px 10px;
    color: var(--color-text);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Barre de "pips" (niveau de bâtiment 1-3, etc.) — remplit visuellement au lieu d'un simple
   texte "Niveau: 2/3", plus lisible d'un coup d'oeil (jauge de jeu classique). */
.hub-pip-row {
    flex-direction: row;
    margin-top: 4px;
}
.hub-pip {
    width: 16px;
    height: 8px;
    margin-right: 3px;
    border-radius: 1px;
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
}
.hub-pip--filled {
    background-color: var(--color-accent);
    border-color: var(--color-accent-hover);
}
.hub-pip--empty {
    background-color: var(--color-glass-fill);
}

.hub-badge-shielded {
    color: rgb(120, 168, 210);
    font-size: 13px;
    -unity-font-style: bold;
}
.hub-badge-urgent {
    color: rgb(224, 110, 96);
    font-size: 14px;
    -unity-font-style: bold;
}
.hub-badge-ok {
    color: var(--color-text-dim);
    font-size: 14px;
}

/* Valeur de ressource (Points d'Action) — voir --color-resource ci-dessus. */
.resource-value {
    color: var(--color-resource);
    -unity-font-style: bold;
}

/* Bandeau d'information contextuelle en haut d'un écran de gestion (Caserne/Bâtiments/Sièges/
   Notifications) — remplace le fond bleu-gris arbitraire (rgba(20,25,30,0.9)) + texte blanc brut
   utilisé jusqu'ici sur ces 4 écrans : il ne réutilisait aucun token de Theme.tss, contrastant avec
   les cartes ".hub-card" juste en dessous qui, elles, suivent bien le langage khaki/laiton du reste
   de l'UI. Même famille que ".hub-card" (panel-2 + liseré) pour que tout l'écran se lise comme un
   seul tableau de bord cohérent plutôt que deux styles superposés. */
.hub-info-banner {
    background-color: var(--color-panel-2);
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--color-panel-border-dim);
    border-left-color: var(--color-accent);
    border-radius: 2px;
    padding: 12px 14px;
    color: var(--color-text-dim);
    font-size: 22px;
    white-space: normal;
}

/* Alerte ACTIONNABLE en tête du Quartier Général (2026-09-30, ex: "votre Zone est assiégée") —
   même famille que .hub-info-banner, mais liseré rouge équipe adverse et disposition en ligne
   (message + bouton d'action à droite) : une information qui demande une réaction ne doit plus
   être enfouie dans un sous-écran. */
.hub-alert-banner {
    flex-direction: row;
    align-items: center;
    background-color: rgb(62, 34, 28);
    border-width: 1px;
    border-left-width: 6px;
    border-color: var(--color-panel-border-dim);
    border-left-color: var(--color-team2);
    border-radius: 2px;
    padding: 10px 12px;
    margin-bottom: 14px;
}

/* Action secondaire discrète (ex: Déconnexion) qui ne doit jamais rivaliser visuellement avec les
   actions de navigation principales — même traitement que AuthScreen "toggle-mode-button" (fond
   transparent, pas de bordure), promu ici en classe réutilisable plutôt que dupliqué inline. */
Button.btn-ghost {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-dim);
    font-size: 22px;
    min-height: 48px;
}

Button.btn-ghost:hover {
    color: var(--color-text);
    background-color: var(--color-glass-fill);
}

/* Regroupe les actions du HUD tactique (cloche/vue 3D/annuler/FIN DE TOUR) en UN SEUL bandeau
   "glass" au lieu de boutons flottants indépendants côte à côte (2026-09-13, retour utilisateur
   direct sur capture d'écran : "ne mets pas les boutons éparpillés comme ça, c'est pas
   gamefiable/intuitif") — même langage visuel que .dock-panel (glass + liseré laiton en haut),
   pour que ce groupe se lise comme UN tableau de bord cohérent plutôt que des morceaux disjoints. */
.hud-action-cluster {
    flex-direction: row;
    align-items: center;
    background-color: rgba(20, 18, 12, 0.72);
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    border-top-width: 2px;
    border-top-color: var(--color-accent);
    border-radius: 4px;
    padding: 6px 10px;
}

/* white-space: normal en base, ici et sur Button ci-dessous : par défaut, UI Toolkit NE fait PAS
   passer le texte à la ligne (nowrap) et le laisse déborder de son conteneur silencieusement. En
   le forçant une fois ici plutôt que par écran (ce qui s'oubliait), aucun texte ne peut plus
   dépasser un bouton/label — cf. l'incident du menu de démarrage où le titre a débordé du panneau. */
Label {
    color: var(--color-text);
    -unity-font-style: normal;
    -unity-font-definition: var(--font-body);
    font-size: 34px;
    white-space: normal;
}

.title {
    font-size: 40px;
    -unity-font-style: normal;
    -unity-font-definition: var(--font-head);
    color: var(--color-accent);
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    white-space: normal;
}

.subtitle {
    font-size: 28px;
    color: var(--color-text-dim);
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    white-space: normal;
}

.panel {
    background-color: var(--color-panel);
    border-width: 2px;
    border-top-color: var(--color-panel-border);
    border-left-color: var(--color-panel-border);
    border-right-color: var(--color-panel-border-dim);
    border-bottom-color: var(--color-panel-border-dim);
    padding: 24px;
    border-radius: 2px;
}

.hint {
    font-size: 26px;
    color: var(--color-text-dim);
    letter-spacing: 0.5px;
}

.error-text {
    font-size: 28px;
    color: rgb(224, 110, 96);
    white-space: normal;
}

Button {
    background-color: var(--color-panel-2);
    border-width: 2px;
    border-top-color: var(--bevel-light-soft);
    border-left-color: var(--bevel-light-soft);
    border-right-color: var(--bevel-dark);
    border-bottom-color: var(--bevel-dark);
    border-radius: 2px;
    color: var(--color-text);
    font-size: 32px;
    -unity-font-definition: var(--font-body);
    -unity-font-style: bold;
    letter-spacing: 1px;
    padding: 16px;
    min-height: 64px;
    white-space: normal;
    -unity-text-align: middle-center;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
}

/* --- Icônes vectorielles plates (Assets/UI/Icons/*.png, silhouette blanche + tint-color) ---
   Remplacent les emoji (rendu non fiable sur Android une fois une police custom assignée,
   celle-ci n'ayant pas de glyphes emoji de repli). Un bouton à icône n'utilise plus l'attribut
   "text" : il contient explicitement un VisualElement.icon puis un Label. */
.icon {
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-text);
}

.icon-sm {
    width: 22px;
    height: 22px;
}

.icon-lg {
    width: 48px;
    height: 48px;
}

Button.btn-with-icon {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    -unity-text-align: middle-left;
}

/* Sélecteurs descendants (espace) plutôt que combinateur enfant ">" : UI Toolkit USS ne
   supporte de façon fiable que la relation descendante, pas le combinateur enfant direct. */
Button.btn-with-icon .icon {
    margin-right: 14px;
}

Button.btn-with-icon .btn-text-col {
    flex-direction: column;
    flex-grow: 1;
    align-items: flex-start;
}

Button.btn-with-icon .btn-text-col Label {
    white-space: normal;
    -unity-text-align: middle-left;
}

/* Bouton carré ne contenant qu'une icône (cloche, fermer, passer...) — remplace l'ancien
   Button.btn-icon pensé pour un unique glyphe emoji centré par sa taille de police. */
Button.btn-icon-only {
    align-items: center;
    justify-content: center;
    padding: 0;
}

.btn-subtitle {
    font-size: 20px;
    color: var(--color-text-dim);
    -unity-font-style: normal;
    margin-top: 2px;
}

Button:hover {
    background-color: rgb(70, 64, 44);
    border-top-color: var(--color-accent);
    border-left-color: var(--color-accent);
}

Button:active {
    background-color: rgb(36, 32, 22);
    border-top-color: var(--bevel-dark);
    border-left-color: var(--bevel-dark);
    border-right-color: var(--bevel-light-soft);
    border-bottom-color: var(--bevel-light-soft);
    scale: 0.97 0.97;
}

Button:disabled {
    background-color: rgb(38, 35, 26);
    border-top-color: var(--color-panel-border-dim);
    border-left-color: var(--color-panel-border-dim);
    border-right-color: var(--color-panel-border-dim);
    border-bottom-color: var(--color-panel-border-dim);
    color: var(--color-text-dim);
}

/* CTA unique par écran — réservée à l'action principale (ex: Fin de tour).
   Fond laiton saturé + texte quasi-noir : c'est la seule couleur de ce type dans
   toute l'UI, donc l'œil la repère immédiatement sur n'importe quel fond de jeu. */
Button.btn-primary {
    background-color: var(--color-accent);
    border-top-color: var(--bevel-light);
    border-left-color: var(--bevel-light);
    border-right-color: var(--bevel-dark);
    border-bottom-color: var(--bevel-dark);
    color: var(--color-accent-text);
    font-size: 36px;
    letter-spacing: 1.5px;
}

Button.btn-primary:hover {
    background-color: var(--color-accent-hover);
}

Button.btn-primary:active {
    background-color: rgb(120, 30, 24);
}

/* Actions secondaires "réelles" (Annuler, Vue 3D, Retour...) : fond plein
   teinté bleu allié, toujours visible au repos, sans jamais rivaliser avec le CTA. */
Button.btn-secondary {
    background-color: rgb(34, 50, 62);
    border-top-color: rgba(114, 168, 208, 0.55);
    border-left-color: rgba(114, 168, 208, 0.4);
    color: var(--color-text);
}

Button.btn-secondary:hover {
    background-color: rgb(44, 64, 80);
    border-top-color: var(--color-team1);
    border-left-color: var(--color-team1);
}

/* Actions destructrices / annulation (Désélectionner, Nettoyer...). */
Button.btn-danger {
    background-color: rgb(84, 34, 28);
    border-top-color: rgba(224, 110, 96, 0.5);
    border-left-color: rgba(224, 110, 96, 0.35);
    color: rgb(248, 224, 216);
}

Button.btn-danger:hover {
    background-color: rgb(112, 44, 36);
    border-top-color: var(--color-danger-hover);
    border-left-color: var(--color-danger-hover);
}

/* Boutons flottants sur des panneaux "glass" (dock, menu contextuel) : fond
   translucide mais jamais sous ~0.14 d'alpha pour rester visible sans survol. */
Button.btn-glass {
    background-color: var(--color-glass-fill);
    border-width: 1px;
    border-color: var(--color-glass-border);
    border-radius: 2px;
}

Button.btn-glass:hover {
    background-color: var(--color-glass-fill-hover);
}

Button.btn-glass:active {
    background-color: var(--color-glass-fill-active);
    scale: 0.97 0.97;
}

/* --- Barre d'escouade (portraits d'unités, coin haut-droit — cf. Commandos) --- */

.squad-portrait {
    width: 68px;
    margin-bottom: 12px;
    align-items: center;
}

Button.squad-portrait-btn {
    width: 64px;
    height: 64px;
    min-height: 64px;
    padding: 0;
    border-radius: 32px;
    background-color: var(--color-panel-2);
    border-width: 3px;
    border-top-color: var(--bevel-light-soft);
    border-left-color: var(--bevel-light-soft);
    border-right-color: var(--bevel-dark);
    border-bottom-color: var(--bevel-dark);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: border-color, scale;
    transition-duration: 0.15s;
}

Button.squad-portrait-btn:hover {
    border-top-color: var(--color-accent);
    border-left-color: var(--color-accent);
}

/* État sélectionné : halo laiton + agrandissement — l'animation demandée, portée
   entièrement par la transition ci-dessus (aucune boucle continue nécessaire). */
Button.squad-portrait-btn.selected {
    border-top-color: var(--color-accent);
    border-left-color: var(--color-accent);
    border-right-color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent-hover);
    scale: 1.15 1.15;
}

/* Pastille de comptage (coin bas-droit d'un portrait d'escouade, voir TacticalPathManager_UI.
   InitSquadBar) — auparavant texte blanc brut sans fond à 12px directement sur l'icône : illisible
   selon la couleur de l'icône en dessous, et bien en-deçà de tout seuil de lisibilité tactile (voir
   rapport utilisateur sur le texte trop petit/incohérences de couleur). Même traitement que
   .notif-badge (fond+bordure opaques, jamais dépendant du contenu affiché derrière). */
.squad-count-badge {
    position: absolute;
    bottom: 2px;
    right: 2px;
    min-width: 22px;
    padding: 1px 4px;
    background-color: rgba(20, 18, 12, 0.9);
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    border-radius: 8px;
    color: var(--color-text);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Ligne du fil de combat (InMatchHudScreen "combat-feed", 2026-09-16) — fond sombre opaque
   systématique (jamais transparent) pour rester lisible sur n'importe quel arrière-plan de carte,
   même langage que .dock-status. La couleur du texte encode l'équipe de l'unité détruite
   (team1-badge/team2-badge existent déjà pour ce même codage ailleurs dans l'UI) : un coup d'œil
   suffit à voir si c'est un allié ou un ennemi qui vient de tomber, sans lire le texte en entier. */
.combat-feed-entry {
    background-color: rgba(20, 18, 12, 0.82);
    border-left-width: 3px;
    border-left-color: var(--color-panel-border-dim);
    border-radius: 2px;
    padding: 4px 10px;
    margin-bottom: 4px;
    font-size: 20px;
    -unity-font-style: bold;
    white-space: normal;
}

.combat-feed-entry--team1 {
    color: var(--color-team1);
    border-left-color: var(--color-team1);
}

.combat-feed-entry--team2 {
    color: var(--color-team2);
    border-left-color: var(--color-team2);
}

/* Pastille de notification (coin haut-droit de la cloche) : ne s'affiche que s'il y a quelque
   chose à signaler (ex: unités alliées en dessous de 50% de vie). */
.notif-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--color-danger);
    border-width: 2px;
    border-color: var(--color-bg-dark);
    color: white;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0;
}

TextField {
    font-size: 30px;
    margin-bottom: 4px;
}

TextField > .unity-text-field__input {
    background-color: rgb(14, 13, 9);
    border-width: 1px;
    border-color: var(--color-panel-border-dim);
    color: var(--color-text);
    padding: 8px;
}

.team1-badge {
    background-color: var(--color-team1);
    color: white;
    padding: 6px 16px;
    border-radius: 2px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.team2-badge {
    background-color: var(--color-team2);
    color: white;
    padding: 6px 16px;
    border-radius: 2px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

