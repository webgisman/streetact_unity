/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*_BurstDebugInformation_DoNotShip/
*_BackUpThisFolder_ButDontShipItWithYourGame/

# Cache de build natif Android (CMake/Gradle, arm64-v8a/armeabi-v7a incrémental) — régénéré
# automatiquement à chaque build Android, aucune raison d'être versionné.
.utmp/

# Fichier de solution Visual Studio 2022+ (équivalent .slnx du .sln déjà ignoré ci-dessous)
*.slnx

# Identifiants serveur (VPS, Supabase, clé SSH) — ne JAMAIS committer, voir CREDENTIALS.md.
/CREDENTIALS.md

# Keystore de signature Android release — perdre ce fichier (ou son mot de passe, voir
# CREDENTIALS.md) rend impossible toute future mise à jour de l'app sur le Play Store.
*.keystore
*.jks

# Build compilé du serveur de jeu headless (gros binaire, régénérable) — voir
# Assets/_ServerDocs/multiplayer/08-known-issues-and-todo.md pour comment le reconstruire.
/Assets/_ServerDocs/multiplayer/game-server/StreetActServer.x86_64
/Assets/_ServerDocs/multiplayer/game-server/StreetActServer_Data/
/Assets/_ServerDocs/multiplayer/game-server/UnityPlayer.so

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Tools/TacticalCoreTests/Harness.csproj est un projet .NET écrit à la main (le harnais de tests
# hors-Editeur, voir Tools/run-tests.ps1) et non un fichier généré par Unity/Visual Studio — sans
# cette exception, le "*.csproj" générique ci-dessus l'ignorait silencieusement, ce qui aurait rendu
# le harnais non fonctionnel après un clone frais (exactement ce que sa mise sous contrôle de
# version visait à éviter, voir le commentaire en tête de run-tests.ps1). bin/obj restent ignorés :
# ce sont de vraies sorties de build .NET, jamais à committer.
!Tools/TacticalCoreTests/Harness.csproj
Tools/TacticalCoreTests/bin/
Tools/TacticalCoreTests/obj/

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Windows store builds
AppPackages/

# Logs de build Unity en mode batch (-logFile), écrits par erreur à la racine du projet au lieu du
# scratchpad de session — pur diagnostic jetable, jamais du contenu à versionner (2026-08-30).
/*.log

# Dossier de récupération automatique de l'Éditeur Unity (scène restaurée après un crash/fermeture
# inattendue) — jamais du contenu source réel.
/Assets/_Recovery/
